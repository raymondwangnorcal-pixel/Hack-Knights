# Copy to .env for local runs. On Railway/Render set these as service variables instead.
# Use the DIRECT Tiger Data connection (not the pooler): the live stream needs LISTEN/NOTIFY.
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=
PGSSLMODE=require

# Snowflake (REST only). Account = ORGNAME-ACCOUNTNAME from Snowsight > account menu > Connect a tool.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PAT=
