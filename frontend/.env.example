# Copy to .env.local. Everything is optional: with nothing set, every route serves mock data.

# Data/ML FastAPI service (e.g. https://buzz-api.up.railway.app). Unset = mocks.
BUZZ_API_URL=

# Gemini (advice + district plans). Unset = grounded fallback text.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs (spoken advice). One voice ID per language code.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_PT=
ELEVENLABS_VOICE_YO=
ELEVENLABS_VOICE_HA=
