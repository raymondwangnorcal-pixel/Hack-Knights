# Copy to .env.local. Everything is optional: with nothing set, every route serves mock data.

# Data/ML FastAPI service (e.g. https://buzz-api.up.railway.app). Unset = mocks.
BUZZ_API_URL=

# Server-only Gemini key (prevention choices/translations, advice + district plans).
# Add the real value to .env.local or Vercel Environment Variables, never here.
# Unset = grounded fallback text and general/rules-based prevention actions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ElevenLabs (spoken advice). A language gets a play button only when its voice ID is set,
# so leave a language blank until its voice has been tested. Voice IDs are not secrets.
# Set on Vercel (Production + Preview) on 2026-10-10:
#   EN Tobi (Nigerian English) · PT Fabi (Brazilian Portuguese) · HA Ibrahim (Hausa, needs eleven_v3)
#   ES / FR / ZH Sarah (built-in multilingual default; the free plan has 3 library-voice slots)
# Yoruba (YO) and Cantonese (YUE) have no ElevenLabs model: keep them blank (text-only).
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_MODEL_HA=eleven_v3
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_PT=
ELEVENLABS_VOICE_ES=
ELEVENLABS_VOICE_FR=
ELEVENLABS_VOICE_ZH=
ELEVENLABS_VOICE_HA=
ELEVENLABS_VOICE_YUE=
ELEVENLABS_VOICE_YO=
